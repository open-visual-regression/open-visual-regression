# Copy to .env and edit before running `docker compose up`.

# --- Required ---------------------------------------------------------------
# Secret used to sign auth sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL the app is served from. Change this if you are not on localhost.
# Read at runtime (no rebuild needed); used for auth trusted origins and links.
BASE_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
DATABASE_NAME=open_visual_regression
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# --- Object storage ---------------------------------------------------------
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin
STORAGE_BUCKET=ovr
STORAGE_REGION=us-east-1

# --- Worker -----------------------------------------------------------------
# Number of capture groups processed in parallel per worker.
OVR_CAPTURE_GROUP_CONCURRENCY=2

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info

# --- Ports (host side) ------------------------------------------------------
WEB_PORT=3000
DATABASE_PORT=5432
VALKEY_PORT=6379
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
BULL_BOARD_PORT=3001
ADMINER_PORT=8080

# --- Container user ---------------------------------------------------------
# UID/GID the app containers run as. Match your host user to keep ownership of
# mounted volumes aligned. Applied at build time, so rebuild after changing.
PUID=1001
PGID=1001

# --- Images -----------------------------------------------------------------
# Override to pull published images instead of building locally, e.g.
# IMAGE_PREFIX=docker.io/yourorg
IMAGE_PREFIX=open-visual-regression
IMAGE_TAG=latest
