# Copy to .env and edit before running `docker compose up`.

# --- Required ---------------------------------------------------------------
# Secret used to sign auth sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL the app is served from. Change this if you are not on localhost.
# Used for auth trusted origins and links.
BASE_URL=http://localhost:3000

# --- Bundled data services --------------------------------------------------
# Configure the bundled Postgres and rustfs containers. The app reads
# DATABASE_URL / STORAGE_* (below), which compose derives from these.
DATABASE_NAME=open_visual_regression
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin
STORAGE_BUCKET=ovr
STORAGE_REGION=us-east-1

# --- External services (override for Helm / managed infra) ------------------
# Default to the bundled db / valkey; set to point at managed instances.
# DATABASE_URL=postgresql://user:pass@host:5432/open_visual_regression
# REDIS_URL=redis://host:6379

# Object storage is any S3-compatible service (defaults to the bundled rustfs).
#   STORAGE_ENDPOINT          internal address the app uses; unset for AWS S3
#   STORAGE_PUBLIC_ENDPOINT   address baked into presigned URLs for CI/browsers;
#                             defaults to http://localhost:<STORAGE_PORT>, unset for AWS S3
#   STORAGE_FORCE_PATH_STYLE  true for rustfs/R2, false for AWS S3
#   STORAGE_ACCESS_KEY/SECRET unset to use the AWS default credential chain
# STORAGE_ENDPOINT=https://s3.example.com
# STORAGE_PUBLIC_ENDPOINT=https://storage.example.com
# STORAGE_FORCE_PATH_STYLE=false

# --- Optional tuning (defaults shown) ---------------------------------------
LOG_LEVEL=info
# LOG_FILE_PATH=                       # unset = log to stdout
OVR_CAPTURE_GROUP_CONCURRENCY=2        # capture groups processed in parallel per worker
# OVR_CAPTURE_GROUP_SIZE=
# OVR_REAPER_STALE_MINUTES=
# OVR_STORYBOOK_CACHE_BYTES=

# --- Ports (host side) ------------------------------------------------------
WEB_PORT=3000
DATABASE_PORT=5432
REDIS_PORT=6379
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001
BULL_BOARD_PORT=3001
ADMINER_PORT=8080

# --- Container user ---------------------------------------------------------
# UID/GID the app containers run as. Match your host user to keep ownership of
# mounted volumes aligned. Applied at build time, so rebuild after changing.
PUID=1001
PGID=1001

# --- Images -----------------------------------------------------------------
# Override to pull published images instead of building locally, e.g.
# IMAGE_PREFIX=docker.io/yourorg
IMAGE_PREFIX=ovr
IMAGE_TAG=latest
