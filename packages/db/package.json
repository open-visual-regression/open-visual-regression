{
  "name": "@ovr/db",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ovr/logger": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@ovr/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
