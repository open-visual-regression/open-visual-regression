{
  "name": "@ovr/builds",
  "version": "0.2.10",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "test": "vitest run"
  },
  "dependencies": {
    "@ovr/api": "workspace:*",
    "@ovr/db": "workspace:*",
    "@ovr/logger": "workspace:*",
    "@ovr/metrics": "workspace:*",
    "@ovr/queue": "workspace:*",
    "@ovr/storage": "workspace:*",
    "@ovr/storybook-compat": "workspace:*",
    "tar": "^7.5.22",
    "uuid": "^14.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ovr/testing": "workspace:*",
    "@ovr/typescript-config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.3",
    "bullmq": "^5.81.3",
    "ioredis": "5.11.1",
    "pg": "^8.22.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
