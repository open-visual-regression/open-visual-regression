    "test": "vitest run"
  },
  "dependencies": {
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@ovr/typescript-config": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
