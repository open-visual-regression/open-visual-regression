{
  "extends": "@ovr/typescript-config/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
    },
    "moduleResolution": "bundler",
    "resolvePackageJsonImports": true,
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"],
}
