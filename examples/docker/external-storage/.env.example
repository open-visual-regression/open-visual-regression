# Copy to .env and edit before running `docker compose up`.

# --- Required ---------------------------------------------------------------
# Secret used to sign auth sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Key used to encrypt stored git provider tokens (CI status checks) at rest.
# Required. Must decode to 32 bytes. Generate one with: openssl rand -base64 32
OVR_GIT_TOKEN_ENCRYPTION_KEY=

# Public URL the app is served from. Change this if you are not on localhost.
BASE_URL=http://localhost:3000

# --- Object storage (S3-compatible) ------------------------------------------
# The bucket must already exist; this example doesn't create it for you.
STORAGE_BUCKET=your-bucket-name
STORAGE_REGION=us-east-1

# Real AWS S3: leave both endpoints unset and STORAGE_FORCE_PATH_STYLE=false.
# STORAGE_ENDPOINT=
# STORAGE_PUBLIC_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false

# Leave both keys unset to use the AWS default credential chain (IAM role,
# instance profile, etc.) instead of static keys.
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# --- Bundled Postgres and Redis -----------------------------------------------
DATABASE_NAME=open_visual_regression
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# --- Optional tuning (defaults shown) ---------------------------------------
LOG_LEVEL=info
OVR_CAPTURE_GROUP_CONCURRENCY=2

# --- Ports (host side) ------------------------------------------------------
WEB_PORT=3000
DATABASE_PORT=5432
REDIS_PORT=6379

# --- Images -----------------------------------------------------------------
IMAGE_PREFIX=ghcr.io/open-visual-regression
IMAGE_TAG=latest
