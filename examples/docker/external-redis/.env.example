# Copy to .env and edit before running `docker compose up`.

# --- Required ---------------------------------------------------------------
# Secret used to sign auth sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Key used to encrypt stored git provider tokens (CI status checks) at rest.
# Required. Must decode to 32 bytes. Generate one with: openssl rand -base64 32
OVR_GIT_TOKEN_ENCRYPTION_KEY=

# Public URL the app is served from. Change this if you are not on localhost.
BASE_URL=http://localhost:3000

# --- External Redis -----------------------------------------------------------
# Connection string from your provider (Upstash, ElastiCache, Memorystore,
# etc.). Use rediss:// if your provider requires TLS.
REDIS_URL=redis://user:pass@host:6379

# --- Bundled Postgres and object storage ---------------------------------------
DATABASE_NAME=open_visual_regression
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin
STORAGE_BUCKET=ovr
STORAGE_REGION=us-east-1

# --- Optional tuning (defaults shown) ---------------------------------------
LOG_LEVEL=info
OVR_CAPTURE_GROUP_CONCURRENCY=2

# --- Ports (host side) ------------------------------------------------------
WEB_PORT=3000
DATABASE_PORT=5432
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

# --- Images -----------------------------------------------------------------
IMAGE_PREFIX=ghcr.io/open-visual-regression
IMAGE_TAG=latest
