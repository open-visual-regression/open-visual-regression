# Points the stack at the fake GitHub API (the `github` compose service). The CI
# workflow appends a throwaway key pair to .env: OVR_GITHUB_APP_PRIVATE_KEY for the
# app, FAKE_GITHUB_PUBLIC_KEY for the fake to verify its JWTs.
OVR_GITHUB_APP_CLIENT_ID=Iv23liE2E
OVR_GITHUB_API_URL=http://github:8090
