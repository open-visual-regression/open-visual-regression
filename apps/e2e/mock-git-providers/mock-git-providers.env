# Points the stack's git providers at the mock-git-providers compose service. The E2E
# workflow appends a throwaway key pair to .env: OVR_GITHUB_APP_PRIVATE_KEY for the app,
# FAKE_GITHUB_PUBLIC_KEY for the mock to verify its JWTs.
OVR_GITHUB_APP_CLIENT_ID=Iv23liE2E
OVR_GITHUB_API_URL=http://mock-git-providers:8090
