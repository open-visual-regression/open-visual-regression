BASE_URL=http://localhost:4180
OVR_AUTH_MODE=trusted-proxy
OVR_AUTH_PROXY_TOKEN_HEADER=authorization
OVR_AUTH_PROXY_ISSUER=http://keycloak:8081/realms/ovr
OVR_AUTH_PROXY_AUDIENCE=ovr
OVR_AUTH_PROXY_JWKS_URL=http://keycloak:8081/realms/ovr/protocol/openid-connect/certs
OVR_AUTH_ROLE_GROUPS='{"admin":["ovr-admins"],"reviewer":["ovr-reviewers"],"viewer":["ovr-viewers"]}'
OVR_AUTH_PROXY_LOGOUT_URL=http://localhost:4180/oauth2/sign_out
OVR_AUTH_ACCESS_REQUEST_URL=https://opal.example.com/apps/ovr
