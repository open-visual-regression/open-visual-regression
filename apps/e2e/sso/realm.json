{
  "realm": "ovr",
  "enabled": true,
  "sslRequired": "none",
  "groups": [{ "name": "ovr-admins" }, { "name": "ovr-reviewers" }, { "name": "ovr-viewers" }],
  "users": [
    {
      "username": "admin@ovr.test",
      "email": "admin@ovr.test",
      "firstName": "SSO",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "e2e-password-123", "temporary": false }],
      "groups": ["/ovr-admins"]
    },
    {
      "username": "reviewer@ovr.test",
      "email": "reviewer@ovr.test",
      "firstName": "SSO",
      "lastName": "Reviewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "e2e-password-123", "temporary": false }],
      "groups": ["/ovr-reviewers"]
    },
    {
      "username": "outsider@ovr.test",
      "email": "outsider@ovr.test",
      "firstName": "SSO",
      "lastName": "Outsider",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "e2e-password-123", "temporary": false }]
    }
  ],
  "clients": [
    {
      "clientId": "ovr",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ovr-e2e-secret",
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:4180/oauth2/callback"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ovr",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
