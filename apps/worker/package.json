    "ioredis": "5.10.1",
    "pg": "8.21.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.57.0",
    "pngjs": "^7.0.0",
    "tar": "^7.5.16"
  },
  "devDependencies": {
    "@ovr/typescript-config": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.7"
  }
