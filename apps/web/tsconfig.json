{
  "extends": "@ovr/typescript-config/nextjs.json",
  "compilerOptions": {
    "strictNullChecks": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
