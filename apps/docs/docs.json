{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Open Visual Regression",
  "colors": {
    "primary": "#F9A300",
    "light": "#F9A300",
    "dark": "#F9A300"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index"]
          },
          {
            "group": "Using OVR",
            "pages": ["baselines", "flaky-snapshots"]
          },
          {
            "group": "Storybook",
            "pages": ["storybook/story-parameters", "storybook/only-affected"]
          },
          {
            "group": "Self-hosting",
            "pages": [
              "self-hosting/docker-compose",
              "self-hosting/helm",
              "self-hosting/sso",
              "self-hosting/github-app",
              "self-hosting/metrics"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "CLI",
            "pages": [
              "cli/overview",
              "cli/authentication",
              "cli/upload-storybook",
              "cli/capture-storybook",
              "cli/builds",
              "cli/snapshots",
              "cli/diffs"
            ]
          },
          {
            "group": "Configuration",
            "pages": ["reference/ovr-config"]
          },
          {
            "group": "Self-hosting",
            "pages": ["reference/environment-variables", "reference/metrics"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/open-visual-regression/open-visual-regression"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/open-visual-regression/open-visual-regression"
    }
  },
  "redirects": [
    {
      "source": "/cli/snapshot-storybook",
      "destination": "/cli/upload-storybook"
    },
    {
      "source": "/cli/installation",
      "destination": "/cli/overview"
    },
    {
      "source": "/configuration/config",
      "destination": "/reference/ovr-config"
    },
    {
      "source": "/configuration/story-parameters",
      "destination": "/storybook/story-parameters"
    }
  ]
}
