{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Open Visual Regression",
  "colors": {
    "primary": "#F9A300",
    "light": "#F9A300",
    "dark": "#F9A300"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "how-ovr-works"]
          },
          {
            "group": "Using OVR",
            "pages": [
              "run-in-ci",
              "review-builds",
              "baselines",
              "flaky-snapshots"
            ]
          },
          {
            "group": "Managing OVR",
            "pages": [
              "manage/projects",
              "manage/users-and-roles",
              "manage/api-keys-and-tokens",
              "manage/git-status-checks"
            ]
          },
          {
            "group": "Storybook",
            "pages": [
              "storybook/overview",
              "storybook/story-parameters",
              "storybook/stable-screenshots",
              "storybook/only-affected"
            ]
          },
          {
            "group": "Self-hosting",
            "pages": [
              "self-hosting/overview",
              "self-hosting/docker-compose",
              "self-hosting/helm",
              "self-hosting/sso",
              "self-hosting/github-app",
              "self-hosting/metrics",
              "self-hosting/upgrading"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "CLI",
            "pages": [
              "cli/overview",
              "cli/upload-storybook",
              "cli/capture-storybook",
              "cli/builds",
              "cli/snapshots",
              "cli/diffs"
            ]
          },
          {
            "group": "Configuration",
            "pages": ["reference/ovr-config"]
          },
          {
            "group": "Builds",
            "pages": ["reference/statuses"]
          },
          {
            "group": "Self-hosting",
            "pages": ["reference/environment-variables", "reference/metrics"]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/open-visual-regression/open-visual-regression"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/open-visual-regression/open-visual-regression"
    }
  },
  "redirects": [
    {
      "source": "/cli/snapshot-storybook",
      "destination": "/cli/upload-storybook"
    },
    {
      "source": "/cli/installation",
      "destination": "/cli/overview"
    },
    {
      "source": "/configuration/config",
      "destination": "/reference/ovr-config"
    },
    {
      "source": "/configuration/story-parameters",
      "destination": "/storybook/story-parameters"
    },
    {
      "source": "/cli/authentication",
      "destination": "/manage/api-keys-and-tokens"
    }
  ]
}
