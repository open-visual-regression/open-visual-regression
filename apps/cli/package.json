{
  "name": "@open-visual-regression/cli",
  "version": "0.1.1",
  "private": false,
  "license": "Elastic-2.0",
  "bin": {
    "ovr": "./bin/ovr.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./config": {
      "types": "./dist/defineConfig.d.ts",
      "default": "./dist/defineConfig.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "tsc": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "test": "vitest run",
    "prepack": "tsup"
  },
  "dependencies": {
    "@orpc/client": "^1.14.14",
    "@orpc/contract": "^1.14.14",
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "ky": "^2.0.2",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@ovr/api": "workspace:*",
    "@ovr/typescript-config": "workspace:*",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
