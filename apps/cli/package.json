{
  "name": "@ovr/cli",
  "version": "0.1.0",
  "private": false,
  "bin": {
    "ovr": "./bin/ovr.mjs"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./config": {
      "types": "./dist/defineConfig.d.ts",
      "default": "./dist/defineConfig.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "tsc": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "test": "vitest run"
  },
  "dependencies": {
    "@orpc/client": "^1.14.6",
    "@orpc/contract": "^1.14.6",
    "@ovr/api": "workspace:*",
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "ky": "^2.0.2",
    "tar": "^7.5.16"
  },
  "devDependencies": {
    "@ovr/typescript-config": "workspace:*",
    "@types/node": "^22.15.3",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.7"
  }
}
