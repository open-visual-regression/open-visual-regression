{
  "name": "@open-visual-regression/cli",
  "version": "0.9.0",
  "private": false,
  "homepage": "https://openvisualregression.com",
  "bugs": "https://github.com/open-visual-regression/open-visual-regression/issues",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-visual-regression/open-visual-regression.git",
    "directory": "apps/cli"
  },
  "bin": {
    "ovr": "./bin/ovr.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./config": {
      "types": "./dist/defineConfig.d.ts",
      "default": "./dist/defineConfig.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "tsc": "tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src",
    "test": "vitest run",
    "prepack": "tsup"
  },
  "dependencies": {
    "@orpc/client": "^1.14.14",
    "@orpc/contract": "^1.14.14",
    "@pnpm/dependency-path": "^1001.1.10",
    "@streamparser/json-node": "^0.0.26",
    "@yarnpkg/parsers": "^3.1.0",
    "commander": "^15.0.0",
    "jiti": "^2.7.0",
    "jsonc-parser": "^3.3.1",
    "ky": "^2.0.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tar": "^7.5.22",
    "uuid": "^14.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@ovr/api": "workspace:*",
    "@ovr/capture-browser": "workspace:*",
    "@ovr/diff-analysis": "workspace:*",
    "@ovr/storybook-compat": "workspace:*",
    "@ovr/typescript-config": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "playwright": "1.61.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.11"
  }
}
