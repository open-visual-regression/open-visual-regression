{
  "name": "open-visual-regression",
  "private": true,
  "license": "Elastic-2.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:ci": "turbo run lint -- --deny-warnings",
    "format": "turbo run format",
    "tsc": "tsc --noEmit",
    "check-types": "turbo run tsc",
    "test": "turbo run test",
    "build-storybook": "turbo run build-storybook",
    "db:generate": "pnpm --filter @ovr/db db:generate",
    "db:migrate": "pnpm --filter @ovr/db db:migrate",
    "db:push": "pnpm --filter @ovr/db db:push",
    "db:studio": "pnpm --filter @ovr/db db:studio",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@fission-ai/openspec": "^1.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "turbo": "^2.9.14",
    "typescript": "6.0.3",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxfmt",
      "oxlint"
    ],
    "!(pnpm-lock).{css,json,yaml,yml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0"
}
